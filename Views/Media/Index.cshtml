@model IEnumerable<MarvelArchive.ViewModels.MediaViewModel>
@{
    ViewData["Title"] = "Media";
}

<h1>Marvel Movies/TV Shows</h1>
<br />

<form asp-action="Index">
    <label>Search:</label>

    <br />

    <div class="search-container">
        <input type="search" id="search" name="search" value="@ViewBag.Search" placeholder="Search Media" autocomplete="off" />

        <div id="searchSuggestions" class="search-suggestions"></div>
    </div>

    <br />

    <label>Type:</label>
    <select id="type" name="type">
        <option value="all"
                selected="@(ViewBag.Type == "all" ? "selected" : null)">
            All
        </option>
        <option value="movie"
                selected="@(ViewBag.Type == "movie" ? "selected" : null)">
            Movies
        </option>
        <option value="tvshow"
                selected="@(ViewBag.Type == "tvshow" ? "selected" : null)">
            Tv Shows
        </option>
    </select>

    <br />

    <label>Sort:</label>
    <select id="sort" name="sort" class="form-select">
        <option value="atoz"
                selected="@(ViewBag.SortOrder == "atoz" ? "selected" : null)">
            A - Z
        </option>
        <option value="ztoa"
                selected="@(ViewBag.SortOrder == "ztoa" ? "selected" : null)">
            Z - A
        </option>
    </select>

    <button type="submit">Search</button>
    <button type="reset">Reset</button>
</form>

<br />
<br />

@if (User.IsInRole("Admin"))
{
    <a asp-action="Create">+ Create New</a>
}

<br />
<br />

<table id="mediaTable">
    <thead>
        <tr>
            <th>Movie Name</th>
            <th>Description</th>
            <th></th>
        </tr>
    </thead>
    <tbody id="mediaList">
        @foreach (var media in Model)
        {
            @if ((User.IsInRole("Admin")) || media.IsVisible)
            {
                <tr>
                    <td><a asp-action="Details" asp-route-id="@media.Id">@media.Title</a></td>
                    <td>@media.Description</td>
                    <td>
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Edit" asp-route-id="@media.Id">Edit</a>
                            <a asp-action="Delete" asp-route-id="@media.Id">Delete</a>
                        }

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <button type="button" class="btn btn-primary add-to-collection" data-media-id="@media.Id" data-item-type="media">
                                Add to Collection
                            </button>
                        }
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

@await Html.PartialAsync("_AddToCollectionDialog")

@if (ViewBag.TotalPages > 1)
{
    <div class="mt-3">
        @if (ViewBag.CurrentPage > 1)
        {
            <a asp-action="Index"
               asp-route-searchTerm="@ViewBag.SearchTerm"
               asp-route-type="@ViewBag.Type"
               asp-route-sortOrder="@ViewBag.SortOrder"
               asp-route-page="@(ViewBag.CurrentPage - 1)">
                Previous
            </a>
        }

        <span class="mx-2">
            Page @ViewBag.CurrentPage of @ViewBag.TotalPages
        </span>

        @if (ViewBag.CurrentPage < ViewBag.TotalPages)
        {
            <a asp-action="Index"
               asp-route-search="@ViewBag.Search"
               asp-route-type="@ViewBag.Type"
               asp-route-sort="@ViewBag.Sort"
               asp-route-page="@(ViewBag.CurrentPage + 1)">
                Next
            </a>
        }
    </div>
}

<script>
    const searchInput = document.getElementById("search");
    const suggestionsContainer = document.getElementById("searchSuggestions");

    const suggestionsUrl = '@Url.Action("SearchSuggestions", "Media")';
    const detailsUrl = '@Url.Action("Details", "Media")';

    searchInput.addEventListener("input", function () {

        const searchTerm = searchInput.value.trim();

        if (searchTerm.length < 2) {
            suggestionsContainer.innerHTML = "";
            suggestionsContainer.style.display = "none";
            return;
        }

        const url = `${suggestionsUrl}?term=${encodeURIComponent(searchTerm)}`;

        fetch(url)
            .then(response => {
                if (!response.ok) {
                    throw new Error(`HTTP error: ${response.status}`);
                }

                return response.json();
            }).then(data => {

                suggestionsContainer.innerHTML = "";

                if (data.length === 0) {
                    suggestionsContainer.style.display = "none";
                    return;
                }

                data.forEach(media => {

                    const suggestion = document.createElement("a");

                    suggestion.classList.add("search-suggestion");
                    suggestion.href = `${detailsUrl}/${media.id}`;

                    const title = document.createElement("strong");
                    title.textContent = media.title;

                    const type = document.createElement("span");
                    type.textContent = ` (${media.type})`;

                    suggestion.appendChild(title);
                    suggestion.appendChild(type);

                    suggestionsContainer.appendChild(suggestion);
                });

                suggestionsContainer.style.display = "block";
            }).catch(error => {
                console.error("Search request failed:", error);
            });
    });
</script>