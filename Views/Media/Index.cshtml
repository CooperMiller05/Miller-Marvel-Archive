@model IEnumerable<MarvelArchive.Models.Media>
@{
    ViewData["Title"] = "Media";
}

<h1>Marvel Movies/TV Shows</h1>
<br />

<label>Search: </label>
<input type="text" id="search" placeholder="Search Archive" />

<br /><br />

@if (User.IsInRole("Admin"))
{
    <a asp-action="Create">+ Create New</a>
}

<br /><br />

<table id="mediaTable">
    <thead>
        <tr>
            <th>Movie Name</th>
            <th>Description</th>
            <th></th>
        </tr>
    </thead>
    <tbody id="mediaList">
        @foreach (var media in Model)
        {
            @if ((User.IsInRole("Admin")) || media.IsVisible)
            {
                <tr>
                    <td><a asp-action="Details" asp-route-id="@media.Id">@media.Title</a></td>
                    <td>@media.Description</td>
                    <td>
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Edit" asp-route-id="@media.Id">Edit</a>
                            <a asp-action="Delete" asp-route-id="@media.Id">Delete</a>
                        }
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

<script>
    const searchBox = document.getElementById("search");
    const mediaList = document.getElementById("mediaList");
    const mediaRows = mediaList.querySelectorAll("tr");

    searchBox.addEventListener("input", function() {

        const searchTerm = searchBox.value.toLowerCase();

        for (const row of mediaRows) {

            const rowText = row.textContent.toLowerCase();

            if (rowText.includes(searchTerm)) {
                row.style.display = "";
            } else {
                row.style.display = "none";
            }
        }
    });
</script>