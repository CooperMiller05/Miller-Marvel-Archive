@model IEnumerable<MarvelArchive.Models.Collection>

<h1>Collections</h1>

<br />

<table>
    <thead>
        <tr>
            <th></th>
            <th>Collection Name</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var collection in Model)
        {
            <tr>
                <td>Image goes here...</td>
                <td><a class="nav-link text-dark" asp-action="Details" asp-route-id="@collection.Id">@collection.Name</a></td>
            </tr>
        }
    </tbody>
</table>