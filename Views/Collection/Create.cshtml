@model MarvelArchive.Models.Collection
@using System.Security.Claims
@{
    ViewData["Title"] = "Create Collection";
}

<h1>Create a New Collection</h1>

<form asp-action="Create" method="post">
    <input type="hidden" asp-for="UserId" value="@User.FindFirstValue(ClaimTypes.NameIdentifier)" />
    <label>Collection Name:</label>
    <input asp-for="Name" />
    <br />
    <label>Description:</label>
    <textarea asp-for="Description"></textarea>
    <br />
    <label>Do you want this collection to be public?</label>
    <input asp-for="isPublic" />
    <br />
    <button type="submit">Save</button>
</form>

<a asp-action="Index">Cancel</a>