@model IEnumerable<MarvelArchive.Models.Character>

<h1>Marvel Characters</h1>
<br />

<label>Search: </label>
<input type="text" id="search" placeholder="Search Archive" />

<br /><br />

@if (User.IsInRole("Admin"))
{
    <a asp-action="Create">+ Create New</a>
}

<br /><br />

<table id="characterTable">
    <thead>
        <tr>
            <th>Hero Name</th>
            <th>Real Name</th>
            <th>Aliases</th>
            <th>Alignment</th>
            <th></th>
        </tr>
    </thead>
    <tbody id="characterList">
        @foreach (var character in Model)
        {
            <tr>
                <td><a asp-action="Details" asp-route-id="@character.Id">@character.HeroName</a></td>
                <td>@character.RealName</td>
                <td>@character.Aliases</td>
                <td>@character.GetAlignmentValue()</td>
                @if (User.IsInRole("Admin"))
                {
                    <td>
                        <a asp-action="Edit" asp-route-id="@character.Id">Edit</a>
                    </td>
                    <td>
                        <a asp-action="Delete" asp-route-id="@character.Id">Delete</a>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>

<script>
    const searchBox = document.getElementById("search");
    const characterList = document.getElementById("characterList");
    const characterRows = characterList.querySelectorAll("tr");

    searchBox.addEventListener("input", function() {

        const searchTerm = searchBox.value.toLowerCase();

        for (const row of characterRows) {

            const rowText = row.textContent.toLowerCase();

            if (rowText.includes(searchTerm)) {
                row.style.display = "";
            } else {
                row.style.display = "none";
            }
        }
    });
</script>