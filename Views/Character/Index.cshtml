@model IEnumerable<MarvelArchive.ViewModels.CharacterViewModel>
@{
    ViewData["Title"] = "Characters";
}

<h1>Marvel Characters</h1>
<br />

<form asp-action="Index">
    <label>Search:</label>

    <br />

    <div class="search-container">
        <input type="search" id="search" name="search" value="@ViewBag.Search" placeholder="Search Characters" autocomplete="off" />

        <div id="searchSuggestions" class="search-suggestions"></div>
    </div>

    <br />

    <label>Alignment:</label>
    <select id="alignment" name="alignment">
        <option value="all"
                selected="@(ViewBag.Alignment == "all" ? "selected" : null)">
            All
        </option>
        <option value="good"
                selected="@(ViewBag.Alignment == "good" ? "selected" : null)">
            Super Heroes
        </option>
        <option value="bad"
                selected="@(ViewBag.Alignment == "bad" ? "selected" : null)">
            Villains
        </option>
    </select>

    <br />

    <label>Sort:</label>
    <select id="sort" name="sort" class="form-select">
        <option value="atoz"
                selected="@(ViewBag.SortOrder == "atoz" ? "selected" : null)">
            A - Z
        </option>
        <option value="ztoa"
                selected="@(ViewBag.SortOrder == "ztoa" ? "selected" : null)">
            Z - A
        </option>
    </select>

    <button type="submit">Search</button>
    <button type="reset">Reset</button>
</form>

<br />
<br />

@if (User.IsInRole("Admin"))
{
    <a asp-action="Create">+ Create New</a>
}

<br />
<br />

<table id="characterTable">
    <thead>
        <tr>
            <th>Hero Name</th>
            <th>Real Name</th>
            <th>Aliases</th>
            <th>Alignment</th>
            <th></th>
        </tr>
    </thead>
    <tbody id="characterList">
        @foreach (var character in Model)
        {
            @if ((User.IsInRole("Admin")) || character.IsVisible)
            {
                <tr>
                    <td><a asp-action="Details" asp-route-id="@character.Id">@character.HeroName</a></td>
                    <td>@character.RealName</td>
                    <td>@character.Aliases</td>
                    <td>
                        @(character.Alignment == "good" ? "Super Hero" : character.Alignment == "bad" ? "Villain" : "Unknown")
                    </td>
                    <td>
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Edit" asp-route-id="@character.Id">Edit</a>
                            <a asp-action="Delete" asp-route-id="@character.Id">Delete</a>
                        }

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <button type="button"
                                    class="btn btn-primary add-to-collection"
                                    data-item-id="@character.Id"
                                    data-item-type="character">
                                Add to Collection
                            </button>
                        }
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

@await Html.PartialAsync("_AddToCollectionDialog")


@if (ViewBag.TotalPages > 1)
{
    <div class="mt-3">
        @if (ViewBag.CurrentPage > 1)
        {
            <a asp-action="Index"
               asp-route-searchTerm="@ViewBag.SearchTerm"
               asp-route-alignment="@ViewBag.Alignment"
               asp-route-sortOrder="@ViewBag.SortOrder"
               asp-route-page="@(ViewBag.CurrentPage - 1)">
                Previous
            </a>
        }

        <span class="mx-2">
            Page @ViewBag.CurrentPage of @ViewBag.TotalPages
        </span>

        @if (ViewBag.CurrentPage < ViewBag.TotalPages)
        {
            <a asp-action="Index"
               asp-route-search="@ViewBag.Search"
               asp-route-alignment="@ViewBag.Alignment"
               asp-route-sort="@ViewBag.Sort"
               asp-route-page="@(ViewBag.CurrentPage + 1)">
                Next
            </a>
        }
    </div>
}

<script>
    const searchInput = document.getElementById("search");
    const suggestionsContainer = document.getElementById("searchSuggestions");

    const suggestionsUrl = '@Url.Action("SearchSuggestions", "Character")';
    const detailsUrl = '@Url.Action("Details", "Character")';

    searchInput.addEventListener("input", function () {

        const searchTerm = searchInput.value.trim();

        if (searchTerm.length < 2) {
            suggestionsContainer.innerHTML = "";
            suggestionsContainer.style.display = "none";
            return;
        }

        const url = `${suggestionsUrl}?term=${encodeURIComponent(searchTerm)}`;

        fetch(url)
            .then(response => {
                if (!response.ok) {
                    throw new Error(`HTTP error: ${response.status}`);
                }

                return response.json();
            }).then(data => {

                suggestionsContainer.innerHTML = "";

                if (data.length === 0) {
                    suggestionsContainer.style.display = "none";
                    return;
                }

                data.forEach(character => {

                    const suggestion = document.createElement("a");

                    suggestion.classList.add("search-suggestion");
                    suggestion.href = `${detailsUrl}/${character.id}`;

                    const heroName = document.createElement("strong");
                    heroName.textContent = character.heroName;

                    const realName = document.createElement("span");
                    realName.textContent = ` (${character.realName})`;

                    suggestion.appendChild(heroName);
                    suggestion.appendChild(realName);

                    suggestionsContainer.appendChild(suggestion);
                });

                suggestionsContainer.style.display = "block";
            }).catch(error => {
                console.error("Search request failed:", error);
            });
    });
</script>